# Copy to .env and fill the empty values. Do not commit .env.
POSTGRES_PASSWORD=
# Local server only: set a URL with your own password. Docker sets DATABASE_URL internally.
DATABASE_URL=
CHATX_TRUST_PROXY=false
PORT=8787
# Optional HTTPS listener for the installed Android app. The private key stays in server/certs.
# CHATX_TLS_CERT and CHATX_TLS_KEY are paths relative to the server directory.
# VITE_API_ORIGIN is used only inside the Android app, and only if it starts with https://.
CHATX_TLS_CERT=
CHATX_TLS_KEY=
CHATX_TLS_PORT=8443
VITE_API_ORIGIN=
# Web client ID from Google Cloud. The same public ID is used by the page and by the server.
# Authorized JavaScript origins: http://localhost:5173 and http://127.0.0.1:5173
# GOOGLE_CLIENT_SECRET stays in this file. Do not copy it into VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
